# ============================================================
# Ghostty config for macOS (https://ghostty.org/docs/config)
# Place at: ~/.config/ghostty/config.ghostty
#
# Symlink:
# ln -s path/to/dotfiles/ghostty/config.ghostty ~/.config/ghostty/config.ghostty
#
# Reload in Ghostty with: Cmd+Shift+,
# ============================================================

# ----------------------------
# Font
# ----------------------------
font-family = MonoLisa
font-size = 12

# ----------------------------
# Colors
# ----------------------------
theme = Catppuccin Mocha

# ----------------------------
# Window feel
# ----------------------------
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true

background-opacity = 0.97
background-blur = true
unfocused-split-opacity = 0.82

# Nice on macOS
macos-titlebar-style = transparent

# ----------------------------
# Cursor / input behavior
# ----------------------------
cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true

# Treat Option as Alt for shell/editor shortcuts (e.g. Alt-b/f/d in zsh).
# Default for U.S. layouts (https://ghostty.org/docs/config/reference#macos-option-as-alt)
macos-option-as-alt = true

# ----------------------------
# Shell integration / working dir inheritance
# ----------------------------
shell-integration = detect
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# ----------------------------
# Clipboard / selection / links
# ----------------------------
copy-on-select = clipboard
link-url = true
link-previews = true

# ----------------------------
# Scrollback
# ----------------------------
# Scrollback buffer (in bytes) for logs, test runs, and debugging.
# Default is 64 MB. 134217728 = 128 MB.
scrollback-limit = 134217728

# ----------------------------
# Safety
# ----------------------------
confirm-close-surface = true

# ----------------------------
# Keybindings
# ----------------------------

# Prevent accidental quit/close
keybind = cmd+q=ignore
keybind = cmd+w=ignore
keybind = cmd+alt+w=ignore
keybind = cmd+shift+w=close_surface
keybind = cmd+shift+alt+w=ignore

# Splits
keybind = cmd+shift+\=new_split:right
keybind = cmd+shift+-=new_split:down

# Vim-style split navigation
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Titles
keybind = cmd+shift+t=prompt_tab_title
keybind = cmd+shift+s=prompt_surface_title

# Scrolling
keybind = ctrl+shift+u=scroll_page_up
keybind = ctrl+shift+d=scroll_page_down

# Quick terminal
# keybind = global:cmd+backquote=toggle_quick_terminal
# keybind = global:cmd+shift+space=toggle_quick_terminal
