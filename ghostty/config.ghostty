# vim: ft=ghostty
# ============================================================
# Ghostty config for macOS (https://ghostty.org/docs/config)
# Place at: ~/.config/ghostty/config.ghostty
#
# Symlink:
# ln -s path/to/dotfiles/ghostty/config.ghostty ~/.config/ghostty/config.ghostty
#
# Reload in Ghostty with: Cmd+Shift+,
# ============================================================

# ----------------------------
# Font
# ----------------------------
font-family = MonoLisa
font-size = 12

# ----------------------------
# Colors
# Based on Ayu Dark colors
# ----------------------------
background = #0A0E14
foreground = #B3B1AD

palette = 0=#01060E
palette = 1=#EA6C73
palette = 2=#91B362
palette = 3=#F9AF4F
palette = 4=#53BDFA
palette = 5=#FAE994
palette = 6=#90E1C6
palette = 7=#C7C7C7

palette = 8=#686868
palette = 9=#F07178
palette = 10=#C2D94C
palette = 11=#FFB454
palette = 12=#59C2FF
palette = 13=#FFEE99
palette = 14=#95E6CB
palette = 15=#FFFFFF

# ----------------------------
# Window feel
# ----------------------------
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true

# Optional subtle translucency.
# Set to 1.0 if you want fully opaque.
background-opacity = 0.9
background-blur = true

# Nice on macOS
macos-titlebar-style = transparent

# ----------------------------
# Cursor / input behavior
# ----------------------------
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# Treat Option as Alt for shell/editor shortcuts (e.g. Alt-b/f/d in zsh).
# Default for U.S. layouts (https://ghostty.org/docs/config/reference#macos-option-as-alt)
macos-option-as-alt = true

# ----------------------------
# Shell integration / working dir inheritance
# ----------------------------
shell-integration = detect
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# ----------------------------
# Clipboard / selection / links
# ----------------------------
copy-on-select = clipboard
link-url = true
link-previews = true

# ----------------------------
# Scrollback / scrolling
# Scrollback buffer (in bytes) for logs, test runs, and debugging.
# Default is 64 MB. 134217728 = 128 MB.
scrollback-limit = 134217728

# ----------------------------
# Safety
# ----------------------------
confirm-close-surface = true

# ----------------------------
# Keybindings
# ----------------------------

# Prevent accidental quit/close
keybind = cmd+q=ignore
keybind = cmd+w=ignore
keybind = cmd+alt+w=ignore
keybind = cmd+shift+w=ignore
keybind = cmd+shift+alt+w=ignore

# Splits
keybind = cmd+shift+\=new_split:right
keybind = cmd+shift+-=new_split:down

# Vim-style split navigation
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+l=goto_split:right

# Quick terminal
# keybind = global:cmd+backquote=toggle_quick_terminal
# keybind = global:cmd+shift+space=toggle_quick_terminal
